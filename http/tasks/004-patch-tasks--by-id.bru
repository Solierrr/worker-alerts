meta {
  name: [mutates] PATCH /api/v1/tasks/{id}
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/v1/tasks/{{resourceId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{userToken}}
}

body:json {
  {
    "status": "IN_PROGRESS"
  }
}

docs {
  Updates a task. Confirm that the service supports PATCH and this status before sending.
  This operation changes local state.
}
