{
  "name": "@solierrr/worker-alerts",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types --strict-vars=false --env-file=.dev.vars.example",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "hono": "4.13.14",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.11",
    "@types/node": "^24.19.1",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.156.0"
  }
}
